# ─────────────────────────────────────────────────────────────────────────────
# AURA Chart — environment template (backend only)
#
# Copy this file to backend/.env and fill in your values. The React frontend
# NEVER sees these — they live exclusively in the Hono backend process. Do not
# prefix them with VITE_ (that would expose them to the browser bundle).
# ─────────────────────────────────────────────────────────────────────────────

# IG Markets REST API credentials (labs.ig.com -> My API keys)
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=

# Live API:  https://api.ig.com/gateway/deal
# Demo API:  https://demo-api.ig.com/gateway/deal
IG_BASE_URL=https://demo-api.ig.com/gateway/deal

# IG DAX instrument EPIC (account-specific — not just "DAX"). Examples:
#   INDEX:DAX
#   UA.D.DAX.CASH.IP
#   IX.D.DAX.IFD.IP
IG_DAX_EPIC=

# Backend HTTP port (Vite proxies /api to it)
PORT=8787