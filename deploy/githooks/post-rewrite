#!/usr/bin/env bash
# Fires after `git pull --rebase` (and `commit --amend`). Delegates to the
# versioned deploy script — see deploy/redeploy.sh for what gets rebuilt and
# why. Enabled via: git config core.hooksPath deploy/githooks
repo="$(git rev-parse --show-toplevel 2>/dev/null)" || repo="$(cd "$(dirname "$0")/../.." && pwd)"
exec bash "$repo/deploy/redeploy.sh" auto