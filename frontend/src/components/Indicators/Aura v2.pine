//@version=6
indicator("A.U.R.A v2 | JakeJames", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=2500, max_bars_back=500)

// ═══════════════════════════════════════════════════════
// A.U.R.A v2 — Automated Ultimate Setup
// Symbol: IG:DAX  (configurable)
// Timeframe: 3-minute
//
// WORKFLOW:
// EMA, EMA 2 + SMA overlays
// ═══════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════
// SETTINGS
// ═══════════════════════════════════════════════════════
var G_EMA = "EMA Settings"
ema_length    = input.int(9, "EMA Length", minval=1, group=G_EMA)
ema_src       = input.source(close, "EMA Source", group=G_EMA)
ema_offset    = input.int(0, "EMA Offset", minval=-500, maxval=500, group=G_EMA, display=display.none)
ema_color     = input.color(color.green, "EMA Color", group=G_EMA)

var G_EMA2 = "EMA 2 Settings"
ema2_length    = input.int(20, "EMA 2 Length", minval=1, group=G_EMA2)
ema2_src       = input.source(close, "EMA 2 Source", group=G_EMA2)
ema2_offset    = input.int(0, "EMA 2 Offset", minval=-500, maxval=500, group=G_EMA2, display=display.none)
ema2_color     = input.color(color.red, "EMA 2 Color", group=G_EMA2)

var G_SMA = "SMA Settings"
sma_length    = input.int(20, "SMA Length", minval=1, group=G_SMA)
sma_src       = input.source(close, "SMA Source", group=G_SMA)
sma_offset    = input.int(0, "SMA Offset", minval=-500, maxval=500, group=G_SMA, display=display.none)
sma_color     = input.color(color.blue, "SMA Color", group=G_SMA)

// ═══════════════════════════════════════════════════════
// EMA (Moving Average Exponential)
// ═══════════════════════════════════════════════════════
ema_out = ta.ema(ema_src, ema_length)
plot(ema_out, title="EMA", color=ema_color, offset=ema_offset)

// ═══════════════════════════════════════════════════════
// EMA 2 (Second Moving Average Exponential)
// ═══════════════════════════════════════════════════════
ema2_out = ta.ema(ema2_src, ema2_length)
plot(ema2_out, title="EMA 2", color=ema2_color, offset=ema2_offset)

// ═══════════════════════════════════════════════════════
// SMA (Simple Moving Average)
// ═══════════════════════════════════════════════════════
sma_out = ta.sma(sma_src, sma_length)
plot(sma_out, title="SMA", color=sma_color, offset=sma_offset)

// ═══════════════════════════════════════════════════════════════════════════╗
// ║  INTEGRATED: ICT Killzones & Macros  (v1.3.1)                            ║
// ║  Merged into A.U.R.A v2 — provides session time-based killzones and      ║
// ║  macro windows with high/low tracking, next-window previews, and         ║
// ║  opening-price lines. Uses its own timezone setting (default NY).        ║
// ╚══════════════════════════════════════════════════════════════════════════╝
//──────────────────────────────────────────────────────────────────────────────
// Version & Changelog
// v1.3.1  • Minor fixes and improvements. Added more opening prices with defaults.
// v1.3.0  • Alerts: Macro/Killzone pre-start and range-cross (one-shot); dynamic runtime messages.
// v1.1.3  • Feature 3: High/Low lines for current Macro/Killzone windows, with optional extension
// v1.1.2  • Add a next killzone preview that works identicle to the next macro feature.
// v1.1.0  • Update defaults: 5 Killzones, 8 Macros (all macros default gray).
//         • No snap-to-killzone (kept removed).
// v1.0.0  • Removed macro→killzone header snap; independent rendering.
//──────────────────────────────────────────────────────────────────────────────
ICT_VERSION = "v1.3.1"

//#region Inputs
group_general = "General (ICT KZ and Macro)"
tzInput = input.string("America/New_York", "Timezone (IANA, DST-aware)", group = group_general, tooltip = "IANA zone used to interpret sessions (e.g., America/New_York).")
sessionsToShow = input.int(20, "Sessions to show (per window)", group = group_general, minval = 1, maxval = 365, tooltip = "Keeps only the last N completed windows per Macro/Killzone.")

//──────────────────────────────────────────────────────────────────────────────
// Header (global) + Next previews
//──────────────────────────────────────────────────────────────────────────────
group_header = "Header (ICT KZ and Macro)"
hdrHeightTicks   = input.int(40, "Header height (ticks)", minval = 1, maxval = 1000, group = group_header)
hdrGapTicks      = input.int(15, "Header gap (ticks)",   minval = 0, maxval = 1000, group = group_header, tooltip = "Vertical gap between main box top and header.")
hdrBorderWidthIn = input.float(0.0, "Header border width", minval = 0.0, maxval = 6.0, group = group_header, tooltip = "< 1 disables borders.")
hdrBorderStyleIn = input.string("Solid", "Header border style", options = ["Solid","Dashed","Dotted"], group = group_header)
hdrFillOpacity   = input.int(75, "Header fill opacity (0–100)", minval = 0, maxval = 100, group = group_header)
hdrTextSize      = input.string("normal", "Header text size", options = ["tiny","small","normal","large"], group = group_header)
hdrTextColor     = input.color(color.black, "Header text color", group = group_header)
hdrBorderPx      = hdrBorderWidthIn < 1.0 ? 0 : int(math.round(hdrBorderWidthIn))

//──────────────────────────────────────────────────────────────────────────────
// Main box (global style) — used by Macros AND Killzones for the price-action box
//──────────────────────────────────────────────────────────────────────────────
group_macro = "Macro Box (ICT KZ and Macro)"
macroFillOpacity   = input.int(85, "Box fill opacity (0–100)", minval = 0, maxval = 100, group = group_macro)
macroBorderWidthIn = input.float(0.0, "Box border width", minval = 0.0, maxval = 6.0, group = group_macro, tooltip = "< 1 disables borders.")
macroBorderStyleIn = input.string("Solid", "Box border style", options = ["Solid","Dashed","Dotted"], group = group_macro)
macroBorderPx      = macroBorderWidthIn < 1.0 ? 0 : int(math.round(macroBorderWidthIn))

//──────────────────────────────────────────────────────────────────────────────
// High/Low Lines
//──────────────────────────────────────────────────────────────────────────────
group_hl = "High/Low Lines"
showHL       = input.bool(true,  "Show High/Low Lines", group = group_hl)
hlStyleIn    = input.string("Solid", "High/Low Lines Style", options = ["Solid","Dashed","Dotted"], group = group_hl)
extendHL     = input.bool(true,  "Extend High/Low", group = group_hl, tooltip = "Extend after window ends until price crosses the level or the trading day rolls in the chosen timezone.")
extendStyleIn= input.string("Solid", "Extend High/Low Style", options = ["Solid","Dashed","Dotted"], group = group_hl)
extendAcrossDays = input.bool(true, "Extend across days", group = group_hl, tooltip = "If enabled, extended lines continue beyond day roll until price crosses.")
extendWidth      = input.int(2, "Extend line width", minval = 1, maxval = 6, group = group_hl)
showExtLabels    = input.bool(true, "Show ext lines labels", group = group_hl, tooltip = "Show small labels at the live end of unbroken extended lines. H: above, L: below. Hides automatically once price crosses or extension stops.")

hlStyle      = hlStyleIn == "Dashed" ? line.style_dashed : hlStyleIn == "Dotted" ? line.style_dotted : line.style_solid
extendStyle  = extendStyleIn == "Dashed" ? line.style_dashed : extendStyleIn == "Dotted" ? line.style_dotted : line.style_solid

//──────────────────────────────────────────────────────────────────────────────
// Opening Prices
//──────────────────────────────────────────────────────────────────────────────
group_op = "Opening Prices"
opEnableT1 = input.bool(false,  "Time 1", group = group_op)
opTime1    = input.string("03:00", "Time 1 (HH:MM)", group = group_op)
opColorT1  = input.color(color.new(color.gray, 0),   "Time 1 Color", group = group_op)

opEnableT2 = input.bool(false,  "Time 2", group = group_op)
opTime2    = input.string("08:30", "Time 2 (HH:MM)", group = group_op)
opColorT2  = input.color(color.new(color.gray, 0), "Time 2 Color", group = group_op)

opEnableT3 = input.bool(false, "Time 3", group = group_op)
opTime3    = input.string("11:30", "Time 3 (HH:MM)", group = group_op)
opColorT3  = input.color(color.new(color.gray, 0), "Time 3 Color", group = group_op)

opSession  = input.session("1600-1515", "Opening Prices Session", group = group_op, tooltip = "Lines only plot within this session and are removed when the session ends.")
opStyleIn  = input.string("Dotted", "Opening Prices Style", options = ["Solid","Dashed","Dotted"], group = group_op)
opStyle    = opStyleIn == "Dashed" ? line.style_dashed : opStyleIn == "Dotted" ? line.style_dotted : line.style_solid
opWidth    = input.int(1, "Opening Prices Width", minval = 1, maxval = 6, group = group_op)
opLblXFactor = input.float(4, "Label horizontal gap (bar fraction)", minval = 0.0, maxval = 5.0, step = 0.05, group = group_op, tooltip = "Multiply last bar duration to offset label to the right of line end.")
opLblYTicks  = input.int(10, "Label vertical offset (ticks)", minval = -50, maxval = 50, group = group_op, tooltip = "Positive moves label down, negative up, in ticks from line level.")

opShowMidnight   = input.bool(false, "Midnight", group = group_op, tooltip = "Plots a line at 00:00 price inside the session window.")
opColorMidnight  = input.color(color.new(color.gray, 0), "Midnight Color", group = group_op)
opShowNYOpen     = input.bool(true, "NY Open (09:30)", group = group_op, tooltip = "Plots a line at 09:30 New York time.")
opColorNYOpen    = input.color(color.new(color.green, 0), "NY Open Color", group = group_op)

//──────────────────────────────────────────────────────────────────────────────
// Previews — Next Macro/Killzone header toggles
//──────────────────────────────────────────────────────────────────────────────
group_previews = "Previews"
showNextHeader   = input.bool(true, "Show next macro header", group = group_previews)
showNextKZHeader = input.bool(true, "Show next killzone header", group = group_previews)

// Opening Prices — state (single lines only)
var line opT1 = na
var line opT2 = na
var line opT3 = na
// Lightweight text labels at the right end
var label opT1Lbl = na
var label opT2Lbl = na
var label opT3Lbl = na
// Store line levels for quick y positioning
var float opT1Y = na
var float opT2Y = na
var float opT3Y = na

// Built-in lines: state
var line  opMidnight   = na
var line  opNYOpen     = na
var label opMidnightLbl   = na
var label opNYOpenLbl     = na
var float opMidnightY   = na
var float opNYOpenY     = na
// Track session membership is no longer needed for built-ins; retain a flag if needed later
var bool  opWasInSession = false
// Track last opening-prices session start to purge lines on rollover even if no out-of-session bars
var int   opPrevSessStart = na

//──────────────────────────────────────────────────────────────────────────────
// Macro inputs (Macro 1..8) — all default gray
//──────────────────────────────────────────────────────────────────────────────
group_m1 = "Macro 1"
m1Label  = input.string("Macro", "Label", group = group_m1)
