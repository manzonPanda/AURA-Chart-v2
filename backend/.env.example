# ─────────────────────────────────────────────────────────────────────────────
# IG Markets REST API credentials (BACKEND ONLY — never expose to the React UI)
# Copy this file to `backend/.env` and fill in your real values.
# Do NOT prefix these with VITE_ — they must never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Your IG API key (from Client Portal -> My apps / API key on labs.ig.com)
IG_API_KEY=

# Your IG login email/username and password
IG_USERNAME=
IG_PASSWORD=

# Optional: required to address a specific trading account
IG_ACCOUNT_ID=

# Live:  https://api.ig.com/gateway/deal
# Demo:  https://demo-api.ig.com/gateway/deal
IG_BASE_URL=https://demo-api.ig.com/gateway/deal

# The IG DAX instrument EPIC (this is account-specific, NOT just "DAX").
# Examples (confirm the one for your account):
#   IX.D.DAX.IGM.IP   (Germany 40 — confirmed working for streaming)
#   UA.D.DAX.CASH.IP  (DAX cash / spot)
#   IX.D.DAX.IFD.IP   (DAX futures CFD)
#
# To STOP collecting DAX going forward: leave this EMPTY (the default below).
# An empty/unset IG_DAX_EPIC means the backend will NOT subscribe to a DAX
# stream, will NOT backfill DAX, and will NOT schedule DAX collection.
# ⚠️ This does NOT delete or migrate existing DAX rows in Supabase — they
# remain intact and queryable. DAX is also still listed by the frontend
# instrument selector for HISTORICAL viewing (collection ≠ availability).
IG_DAX_EPIC=

# OPTIONAL second instrument — Spot Gold CFD. Leave empty for DAX-only
# behavior (unchanged). When set (Phase 1), the backend streams DAX + Gold
# CONCURRENTLY in one process: per-EPIC Lightstreamer connections on one shared
# IG session, independent aggregation/rollover/persistence, epic-tagged WS
# frames (/ws?epic=… — omitted = DAX). Gold is capture-only (no EMA alerts).
# Verified on the account (ig:market-check):
#   CS.D.CFIGOLD.CFI.IP   "Spot Gold (SGD1 Contract)" — SGD-denominated,
#                         2-decimal quoting (no futures EPIC, no rollover).
IG_GOLD_EPIC=CS.D.CFIGOLD.CFI.IP

# OPTIONAL third instrument — Spot Silver CFD (SMT prep: Gold vs Silver later).
# Leave empty to NOT collect Silver. When set, the backend streams Gold +
# Silver concurrently on the shared IG session with independent aggregation/
# persistence — Silver uses the SAME 1m/3m bucket grid, UTC timestamps and
# closed-candle semantics as Gold so the two are directly comparable for SMT.
# Canonical EPIC (verified via: npm run ig:market-check -- --epic=CS.D.CFDSILVER.CMG.IP):
#   CS.D.CFDSILVER.CMG.IP   "Spot Silver ($1)" — USD-denominated ($1/pt),
#                           2-decimal quoting (same Globex session as Gold).
# (Do NOT use CS.D.CFISILVER.CFI.IP — that is the SGD1 $100 contract variant.)
IG_SILVER_EPIC=CS.D.CFDSILVER.CMG.IP

# Backend server port
PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — completed-candle persistence (BACKEND ONLY, service-role key)
# Supabase → Project Settings → API. Leave empty to run without persistence:
# the realtime IG stream keeps working, /api/candles/db returns 503.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (pooler URI, port 6543) — ONLY for `npm run db:migrate`.
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# EMA Reversal Alerts — Web Push (VAPID). Generate YOUR OWN keypair once:
#   npx web-push generate-vapid-keys
# The PRIVATE key never leaves the backend and is never logged. Push requires
# the app to be served over HTTPS (secure context) in production.
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: start the EMA alert enabled on the FIRST run (before any UI
# change). Afterwards the runtime setting (backend/data/ema-alert-settings.json)
# wins. Values: on | off
EMA_ALERT_ENABLED=off

