# ─────────────────────────────────────────────────────────────────────────────
# IG Markets REST API credentials (BACKEND ONLY — never expose to the React UI)
# Copy this file to `backend/.env` and fill in your real values.
# Do NOT prefix these with VITE_ — they must never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Your IG API key (from Client Portal -> My apps / API key on labs.ig.com)
IG_API_KEY=

# Your IG login email/username and password
IG_USERNAME=
IG_PASSWORD=

# Optional: required to address a specific trading account
IG_ACCOUNT_ID=

# Live:  https://api.ig.com/gateway/deal
# Demo:  https://demo-api.ig.com/gateway/deal
IG_BASE_URL=https://demo-api.ig.com/gateway/deal

# The IG DAX instrument EPIC (this is account-specific, NOT just "DAX").
# Examples (confirm the one for your account):
#   UA.D.DAX.CASH.IP   (DAX cash / spot)
#   IX.D.DAX.IFD.IP   (DAX futures CFD)
#   INDEX:DAX
IG_DAX_EPIC=

# Backend server port
PORT=8787
