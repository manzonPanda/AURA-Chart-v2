# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# Capital.com REST API credentials (BACKEND ONLY — never expose to the React UI)
# The PRIMARY and ONLY active market-data provider for Gold.
# Get these from Capital.com → Settings → API integration.
# Do NOT prefix these with VITE_ — they must never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Your Capital.com API key (sent as the X-CAP-API-KEY header)
CAPITAL_API_KEY=

# The "custom API password" you created when enabling API integration
CAPITAL_API_PASSWORD=

# Your Capital.com account identifier (email) used by POST /api/v1/session
CAPITAL_IDENTIFIER=

# Live:  https://api-capital.backend-capital.com
# Demo:  https://demo-api-capital.backend-capital.com
CAPITAL_API_BASE_URL=https://api-capital.backend-capital.com

# Realtime streaming endpoint (authenticated with X-CAP-API-KEY + CST +
# X-SECURITY-TOKEN per connect — sessions expire ~10 min and the client
# renews automatically; the /connect path is REQUIRED by Capital.com).
CAPITAL_STREAMING_URL=wss://api-streaming-capital.backend-capital.com/connect

# ─────────────────────────────────────────────────────────────────────────────
# IG Markets credentials (RETIRED — no longer read by active runtime)
# The env vars below are documented here for reference only. IG is fully
# retired from active collection/streaming/backfill. They may still exist in
# /etc/aura or backend/.env but are never read — do not set them here.
# ─────────────────────────────────────────────────────────────────────────────
# IG_API_KEY=
# IG_USERNAME=
# IG_PASSWORD=
# IG_ACCOUNT_ID=
# IG_BASE_URL=https://demo-api.ig.com/gateway/deal
# IG_DAX_EPIC=
# IG_GOLD_EPIC=
# IG_SILVER_EPIC=

# Backend server port
PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — LEGACY / AUDIT-ONLY (NOT used by the live runtime).
# The backend persists completed candles to Oracle PostgreSQL (AURA_DB_URL)
# only. These variables are consumed solely by the offline `npm run db:*` audit
# scripts (db:migrate, db:candle-check, db:timeframe-verify, db:tz-verify) and
# by the secret redactor (which scrubs this key from any env/stack-trace dump).
# The realtime Capital stream is wholly unaffected by their presence or absence.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy table-name override for the audit scripts above (defaults to
# ohlc_candles). NOT read by the runtime — the runtime uses CANDLES_TABLE below.
# SUPABASE_CANDLES_TABLE=

# Postgres connection string (pooler URI, port 6543) — ONLY for `npm run db:migrate`.
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Oracle VM) — the canonical market-data store (CandleStore v2).
# The connection comes from the root-only /etc/aura/postgres.env (AURA_DB_URL,
# 0600 root:root) via the systemd EnvironmentFile. For local/dev runs you may
# set it here instead — NEVER commit the real password:
#   AURA_DB_URL=postgresql://aura_app:********@127.0.0.1:5432/aura
# Localhost-only: PostgreSQL is never exposed through nginx / security lists /
# the public internet. Supabase is legacy (audit scripts only — see the
# Supabase section above); it is NOT used by the live runtime.
# ─────────────────────────────────────────────────────────────────────────────
AURA_DB_URL=

# ── Postgres persistence table (runtime) ────────────────────────────────────
# Table that receives completed candles via the Capital MINUTE OHLC stream.
# Defaults to `ohlc_candles` (matches db-migrate.sql). Read by PgCandleStore
# via config.persistence.table. Not a Supabase variable.
CANDLES_TABLE=ohlc_candles


# ─────────────────────────────────────────────────────────────────────────────
# EMA Reversal Alerts — Web Push (VAPID). Generate YOUR OWN keypair once:
#   npx web-push generate-vapid-keys
# The PRIVATE key never leaves the backend and is never logged. Push requires
# the app to be served over HTTPS (secure context) in production.
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: start the EMA alert enabled on the FIRST run (before any UI
# change). Afterwards the runtime setting (backend/data/ema-alert-settings.json)
# wins. Values: on | off
EMA_ALERT_ENABLED=off

