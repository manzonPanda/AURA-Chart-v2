{
  "name": "aura-chart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono + TypeScript API that proxies IG Markets historical price data to the chart frontend.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "ig:check": "node scripts/check-auth.mjs",
    "env-summary": "node scripts/env-summary.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^8.10.0"
  }
}
