# dependencies
node_modules/

# builds
dist/
build/
*.tsbuildinfo

# env — never commit real credentials
.env
.env.local
backend/.env
# env backups — never commit credential snapshots
backend/.env.*.bak


# EMA alert runtime state (settings + push subscriptions) — VM-local only
backend/data/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log

# deploy hook runtime log (also covered by *.log — kept explicit for discoverability)
.last-deploy.log

# frontend deploy freshness state + atomic-swap staging dirs (VM-local only —
# .last-frontend-sha records the commit the live dist was built from; dist.next/
# dist.prev/ are the build/swap staging dirs used by deploy/redeploy.sh)
deploy/.last-frontend-sha
frontend/dist.next/
frontend/dist.prev/